# Copy this file to config.yaml and fill in your own values.
# config.yaml is gitignored — it holds your personal search criteria and
# resume summary, not something you commit.

# ── What you're looking for ─────────────────────────────────────────────────
# Shared across every source. For Adzuna, titles x locations become searches.
# For ATS boards (Greenhouse/Lever/Ashby/Workable/Workday), they filter the fetched postings.
# Empty lists mean "no filter". A posting in a "remote" location always passes
# the location filter.
filters:
  titles:    ["data analyst", "data scientist"]
  locations: ["Adelaide", "Sydney"]
  # Optional. Boards (Greenhouse/Lever/Ashby) often use their own place names,
  # e.g. "SA Western Area" or "Bedford Park / Kaurna Country". Listing those in
  # `locations` would add Adzuna searches, so put them here instead. When set,
  # this list REPLACES `locations` for boards only (repeat your cities in it) and
  # Adzuna ignores it. Entries match whole words, so "SA" matches "SA Western
  # Area" but not "San Francisco". Leave it out to use `locations` for boards.
  # board_locations: ["Adelaide", "SA", "Bedford Park", "Sydney"]

  # Optional ways to cut noise from every source's results (see docs/configuration.md).
  # Titles that also pass the title check without becoming Adzuna searches (no extra
  # API calls). Ignored if `titles` is empty.
  # also_match_titles: ["data engineer", "data science", "ai engineer", "ml engineer", "business analyst"]
  # Words that reject a job when they appear in its title (whole words, any case).
  # Choose these for your own search: "graduate" would drop "Graduate Data Analyst".
  # exclude_titles: ["senior", "sr", "lead", "principal", "staff", "intern", "internship", "freelance"]
  # When set, a "remote" job passes only if it names no place ("Remote", "Global
  # Remote") or one of these regions. Unset = remote passes for any country.
  # remote_regions: ["Australia", "India", "APAC"]

# ── Where to look ───────────────────────────────────────────────────────────
# Sources are just "where". ATS boards (greenhouse/lever/ashby/workable/workday) are global —
# they return a company's whole list and the location filter above keeps the
# ones you want, so non-AU roles (e.g. India: "Bangalore", "Mumbai") come
# through here. Adzuna is per-country: each location is searched only under
# the matching country's source (Adelaide under `au`, Mumbai under `in`).
sources:
  - type: greenhouse
    board: "stripe"                  # token in boards.greenhouse.io/stripe
  - type: lever
    company: "figma"                 # token in jobs.lever.co/figma
  - type: ashby
    org: "ashby"                     # token in jobs.ashbyhq.com/ashby
  - type: workable
    account: "squiz"                 # in apply.workable.com/squiz (case-sensitive)
  - type: workday                    # all three come from the careers URL, e.g.
    tenant: "cba"                    #   https://cba.wd3.myworkdayjobs.com/en-US/CommBank_Careers
    datacenter: "wd3"                # one site per tenant
    site: "CommBank_Careers"
  - type: adzuna
    country: "au"                    # one per country; needs the adzuna: creds below

# Optionally keep a long list of boards in a separate file (see
# sources.txt.example). Its sources are appended to the ones above.
# sources_file: "sources.txt"

llm:
  backend: ollama               # only "ollama" is implemented today
  model: llama3                 # must be pulled already: `ollama pull llama3`
  host: http://localhost:11434
  batch_size: 0                 # max jobs per `make process` run; 0 = whole queue
  max_retries: 2                # extra tries after the first on a failed LLM call
  retry_backoff: 1.0            # base seconds; waits retry_backoff * 2**attempt

# ── Adzuna search API (optional) ────────────────────────────────────────────
# Sanctioned job-search API with a free tier; per-country (au, in, gb, ...).
# It's the only search source, and every `adzuna` source needs these creds.
# Register free at developer.adzuna.com. Without this block, remove the
# `adzuna` sources above or the scrape will stop with a config error.
# adzuna:
#   app_id: "YOUR_ADZUNA_APP_ID"
#   app_key: "YOUR_ADZUNA_APP_KEY"

# ── Where to store it ───────────────────────────────────────────────────────
# Optional. Defaults to sqlite:///data/jobs.db. SQLite is the product; a
# Postgres URL is an open-but-unverified escape hatch (see docs/configuration.md).
# Can also be set via the JOBHUNTER_DATABASE_URL environment variable.
# Dead postings ("To Apply"/"Rejected") are moved to an archive database kept
# for analysis; it defaults to dead_jobs.db next to the main database.
# database:
#   url: "sqlite:///data/jobs.db"
#   archive_url: "sqlite:///data/dead_jobs.db"
